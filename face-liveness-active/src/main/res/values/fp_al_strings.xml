    <string name="fp_al_prepare_title">Get ready</string>
    <string name="fp_al_prepare_body">Your face is checked for spoofing first, then you will be asked to perform %1$d short actions. Hold the phone at eye level in even light, with your whole face inside the circle, and follow the instruction on screen.</string>
