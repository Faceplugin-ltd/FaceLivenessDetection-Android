    <string name="fp_al_state_starting">Hold still…</string>
    <string name="fp_al_state_lost">Face lost — the check starts again</string>
    <string name="fp_al_state_wrong_way">The other way round</string>

    <!-- Why the face in front of the camera cannot be checked -->
    <string name="fp_al_state_too_far">Move closer — your face is too small in the frame</string>
    <string name="fp_al_state_too_close">Move back a little — your face does not fit in the frame</string>
