    <string name="fp_al_check_turn_up">Look up</string>
    <string name="fp_al_check_turn_up_hint">Tilt your head up, keep your eyes on the screen</string>
    <string name="fp_al_check_turn_down">Look down</string>
    <string name="fp_al_check_turn_down_hint">Tilt your head down slowly</string>
    <string name="fp_al_check_turn_left">Turn left</string>
    <string name="fp_al_check_turn_left_hint">Turn your head to your left</string>
