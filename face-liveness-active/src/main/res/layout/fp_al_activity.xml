<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/fp_al_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.faceplugin.faceliveness.active.FaceFrameOverlayView
        android:id="@+id/fp_al_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top bar -->
    <ImageButton
        android:id="@+id/fp_al_btnClose"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/fp_al_bg_chip"
        android:contentDescription="@string/fp_al_close"
        android:padding="11dp"
        android:src="@drawable/fp_al_ic_close" />

    <TextView
        android:id="@+id/fp_al_txtStepCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="26dp"
        android:background="@drawable/fp_al_bg_pill"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:textColor="@color/fp_al_text"
        android:textSize="13sp"
        tools:text="Step 1 of 3" />

    <ImageButton
        android:id="@+id/fp_al_btnSwitchCamera"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/fp_al_bg_chip"
        android:contentDescription="@string/fp_al_switch_camera"
        android:padding="10dp"
        android:src="@drawable/fp_al_ic_switch_camera" />

    <!-- Challenge instruction -->
    <LinearLayout
        android:id="@+id/fp_al_hudInstruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="34dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:id="@+id/fp_al_stepDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:orientation="horizontal" />

        <ImageView
            android:id="@+id/fp_al_imgChallenge"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:background="@drawable/fp_al_bg_pill"
            android:contentDescription="@string/fp_al_title"
            android:padding="16dp"
            android:src="@drawable/fp_al_ic_face" />

        <TextView
            android:id="@+id/fp_al_txtChallengeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/fp_al_text"
            android:textSize="23sp"
            android:textStyle="bold"
            tools:text="Turn left" />

        <TextView
            android:id="@+id/fp_al_txtChallengeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/fp_al_muted"
            android:textSize="14sp"
            tools:text="Turn your head to your left" />
    </LinearLayout>

    <!-- Get-ready panel -->
    <ScrollView
        android:id="@+id/fp_al_panelPrepare"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fp_al_overlay"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="400dp"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/fp_al_bg_icon_circle"
                android:contentDescription="@string/fp_al_title"
                android:padding="18dp"
                android:src="@drawable/fp_al_ic_shield"
                app:tint="@color/fp_al_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/fp_al_prepare_title"
                android:textColor="@color/fp_al_text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fp_al_txtPrepareBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/fp_al_muted"
                android:textSize="15sp"
                tools:text="You will be asked to perform 3 short actions." />

            <TextView
                android:id="@+id/fp_al_btnStart"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/fp_al_bg_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/fp_al_prepare_start"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <!-- Result panel -->
    <FrameLayout
        android:id="@+id/fp_al_panelResult"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fp_al_overlay"
        android:visibility="gone"
        tools:visibility="visible">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/fp_al_bg_sheet"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="22dp"
            android:paddingBottom="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/fp_al_imgResult"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center_horizontal"
                    android:contentDescription="@string/fp_al_result_pass_title"
                    android:src="@drawable/fp_al_ic_pass" />

                <TextView
                    android:id="@+id/fp_al_txtResultTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:textColor="@color/fp_al_text"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Liveness confirmed" />

                <TextView
                    android:id="@+id/fp_al_txtResultBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/fp_al_muted"
                    android:textSize="14sp"
                    tools:text="All 3 challenges were completed by a live person." />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/fp_al_chipDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/fp_al_bg_chip_flat"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:textColor="@color/fp_al_accent"
                        android:textSize="12sp"
                        tools:text="Completed in 6.4 s" />

                    <TextView
                        android:id="@+id/fp_al_chipPassive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/fp_al_bg_chip_flat"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:textColor="@color/fp_al_accent"
                        android:textSize="12sp"
                        tools:text="Passive score 97%" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/fp_al_result_steps_title"
                    android:textAllCaps="true"
                    android:textColor="@color/fp_al_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/fp_al_resultSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/fp_al_btnRetry"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/fp_al_bg_button"
                    android:clickable="true"
                    android:drawablePadding="10dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/fp_al_retry"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/fp_al_ic_retry" />

                <TextView
                    android:id="@+id/fp_al_btnDone"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/fp_al_bg_button_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/fp_al_done"
                    android:textColor="@color/fp_al_text"
                    android:textSize="16sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
