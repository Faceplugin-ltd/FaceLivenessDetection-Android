<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/fp_al_imgStep"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/fp_al_bg_icon_circle"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/fp_al_ic_blink" />

    <TextView
        android:id="@+id/fp_al_txtStep"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:textColor="@color/fp_al_text"
        android:textSize="15sp"
        tools:text="Blink" />

    <TextView
        android:id="@+id/fp_al_txtStepState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/fp_al_muted"
        android:textSize="12sp"
        tools:text="Passed" />
</LinearLayout>
